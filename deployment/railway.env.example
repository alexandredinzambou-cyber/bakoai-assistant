# Variables du service Laravel uniquement. Ne jamais les ajouter dans Vercel.
# Remplacer toutes les valeurs CHANGE_ME et APP_URL avant de déployer.
APP_NAME="PVIT Assistant"
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_URL=https://CHANGE_ME.up.railway.app
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# Variables de référence Railway : le service de base doit s'appeler Postgres.
DB_HOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_DATABASE=${{Postgres.POSTGRES_DB}}
DB_USERNAME=${{Postgres.POSTGRES_USER}}
DB_PASSWORD=${{Postgres.POSTGRES_PASSWORD}}
DB_SSLMODE=prefer

# Les migrations sont exécutées en pre-deploy par railway.toml.
RAILPACK_SKIP_MIGRATIONS=true
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Le chat /mistral-raw/ask utilise directement le fournisseur Mistral.
LLM_DEFAULT_PROVIDER=mistral
LLM_FALLBACK_PROVIDERS=mistral
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=CHANGE_ME
MISTRAL_MODEL=open-mistral-nemo
MISTRAL_VISION_MODEL=ministral-8b-latest
MISTRAL_TIMEOUT=45

EMBEDDING_DEFAULT_PROVIDER=nvidia
EMBEDDING_FALLBACK_PROVIDERS=nvidia
EMBEDDING_ALLOW_PROVIDER_FALLBACK=false
EMBEDDING_DIMENSIONS=768
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_API_KEY=CHANGE_ME
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RAG_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
RAG_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=10
RAG_RRF_RANK_CONSTANT=60
RAG_MIN_CONFIDENCE=0.25
RAG_LLM_CONFIDENCE_FLOOR=0.20
RAG_EXPOSE_CONFIDENCE=false
RAG_ALLOWED_SOURCE_HOSTS=docs.mypvit.pro
RAG_ALLOWED_SOURCE_PATH_PREFIXES=/fr/,/openapi/
RAG_VERIFY_SOURCE_URLS=true
RAG_ADMIN_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET
